{
  "name": "@vylo/app",
  "version": "0.1.0",
  "private": true,
  "description": "Vylo — a global travel map: explore, save, meet, share",
  "scripts": {
    "dev": "node scripts/copy-map-worker.mjs && pnpm world && next dev --port 3100",
    "build": "node scripts/copy-map-worker.mjs && pnpm world && next build",
    "start": "npx serve out -l 3100",
    "world": "node --experimental-strip-types --no-warnings scripts/build-world.mts",
    "typecheck": "pnpm world && tsc --noEmit",
    "i18n:check": "node --experimental-strip-types --no-warnings scripts/check-i18n.mts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3"
  }
}
