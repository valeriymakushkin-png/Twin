/**
 * Imports the passport × destination matrix into src/data/visa/matrix.ts.
 * Source: Passport Index data (passportindex.org), packaged at github.com/imorte/passport-index-data (MIT).
 * Usage: node --experimental-strip-types scripts/import-visa-matrix.mts <passport-index-tidy-iso2.csv> <YYYY-MM-DD>
 * Download the CSV from https://raw.githubusercontent.com/imorte/passport-index-data/main/passport-index-tidy-iso2.csv
 * Corrections newer than the dataset live in the visa guides (src/data/visa/guides/*.ts → overrides).
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const [file, date] = process.argv.slice(2);
if (!file || !/^\d{4}-\d{2}-\d{2}$/.test(date ?? '')) {
  console.error('usage: import-visa-matrix.mts <tidy-iso2.csv> <YYYY-MM-DD>');
  process.exit(1);
}

const STATUS: Record<string, string> = { 'visa free': 'f', 'visa on arrival': 'a', eta: 't', 'e-visa': 'e', 'visa required': 'r', 'no admission': 'x', '-1': '-' };
const rows = readFileSync(file, 'utf8').trim().split('\n').slice(1).map((l) => l.split(','));
const codes = [...new Set(rows.flatMap(([p, d]) => [p, d]))].sort();
const days = [...new Set(rows.map((r) => r[2]).filter((v) => /^\d+$/.test(v)).map(Number))].sort((a, b) => a - b);
const DAY_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
if (days.length > DAY_CHARS.length) throw new Error('too many distinct day counts');
const dayChar = new Map(days.map((d, i) => [d, DAY_CHARS[i]]));

const cell = new Map<string, string>();
for (const [p, d, v] of rows) {
  const c = /^\d+$/.test(v) ? dayChar.get(Number(v)) : STATUS[v];
  if (!c) throw new Error(`unknown value "${v}" for ${p}→${d}`);
  cell.set(`${p}${d}`, c);
}
const lines = codes.map((p) => codes.map((d) => (p === d ? '-' : (cell.get(`${p}${d}`) ?? '?'))).join(''));
const missing = lines.join('').split('?').length - 1;

const out = `// Generated by scripts/import-visa-matrix.mts — do not edit; corrections go into the visa guides.
// Passport Index data (passportindex.org) via github.com/imorte/passport-index-data, MIT licence.

/** Date of the source snapshot */
export const MATRIX_DATE = '${date}';

/** Passports and destinations (ISO 3166-1 alpha-2), in row/column order */
export const CODES = '${codes.join('')}';

/**
 * Cell alphabet: f visa-free (days unknown), a visa on arrival, t ETA, e e-visa, r visa required,
 * x no admission, - same country, ? no data; an upper-case letter is visa-free for DAYS[letter] days.
 */
export const DAYS: Record<string, number> = ${JSON.stringify(Object.fromEntries([...dayChar].map(([d, c]) => [c, d])))};

/** One row per passport, one character per destination */
export const ROWS: string[] = [
${lines.map((l) => `  '${l}',`).join('\n')}
];
`;
writeFileSync(join(dirname(fileURLToPath(import.meta.url)), '../src/data/visa/matrix.ts'), out);
console.log(`✓ matrix: ${codes.length} passports × ${codes.length} destinations, ${days.length} day counts, ${missing} gaps`);
