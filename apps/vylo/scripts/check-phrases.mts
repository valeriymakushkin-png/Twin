/**
 * Validates the phrasebook packs in src/data/phrases (one file per language) and rewrites index.ts.
 * Checks: every phrase id present and non-empty, Latin-script romanisation for non-Latin languages, no stray
 * Latin letters inside native text of non-Latin languages, a note in all six UI languages, a date, and that the
 * numbers differ from each other. Prints every problem; exit 1 if any.
 * Run: node --experimental-strip-types --no-warnings scripts/check-phrases.mts
 */
import { readdirSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
import { ALL_PHRASES, type PhrasePack } from '../src/data/phrases/types.ts';

const dir = join(dirname(fileURLToPath(import.meta.url)), '../src/data/phrases');
const files = readdirSync(dir).filter((f) => /^[a-z]{2}\.ts$/.test(f)).sort();
const LOCALES = ['ru', 'en', 'es', 'de', 'fr', 'it'] as const;
const problems: string[] = [];
const langs: string[] = [];
const LATIN = /[A-Za-zÀ-ɏ]/;
/** Any letter outside the Latin script (Cyrillic, Greek, Arabic, Indic, Thai, Khmer, CJK, Hangul…); modifier letters like Uzbek ʻ count as Latin. */
const NON_LATIN_SCRIPT = { test: (s: string) => [...s].some((c) => /\p{L}/u.test(c) && !/[\p{Script=Latin}\p{Script=Common}\p{Script=Inherited}]/u.test(c)) };
const WORDS = (s: string) => s.trim().split(/\s+/).length;

for (const file of files) {
  const code = file.slice(0, 2);
  const pack = (await import(join(dir, file))).default as PhrasePack;
  const at = (m: string) => problems.push(`${code}: ${m}`);
  langs.push(code);
  if (pack.lang !== code) at(`lang is "${pack.lang}"`);
  if (!/^[a-z]{2,3}-[A-Z]{2}$/.test(pack.speech ?? '')) at(`speech tag "${pack.speech}" is not like th-TH`);
  if (!/^\d{4}-\d{2}$/.test(pack.checked ?? '')) at('checked must be YYYY-MM');
  for (const l of LOCALES) if (!pack.note?.[l]?.trim()) at(`note.${l} missing`);
  for (const id of ALL_PHRASES) if (!pack.text?.[id]?.trim()) at(`text.${id} missing`);
  for (const id of Object.keys(pack.text ?? {})) if (!ALL_PHRASES.includes(id as never)) at(`unknown phrase id ${id}`);
  const native = ALL_PHRASES.map((id) => pack.text?.[id] ?? '').join(' ');
  const nonLatin = NON_LATIN_SCRIPT.test(native);
  if (nonLatin) {
    if (!pack.roman) at('non-Latin script needs a roman table');
    else for (const id of ALL_PHRASES) if (!pack.roman[id]?.trim()) at(`roman.${id} missing`);
  } else if (pack.roman) at('Latin-script language must not have a roman table');
  if (pack.roman) for (const id of ALL_PHRASES) if (NON_LATIN_SCRIPT.test(pack.roman[id] ?? '')) at(`roman.${id} contains non-Latin letters`);
  const nums = ['n0', 'n1', 'n2', 'n3', 'n4', 'n5', 'n6', 'n7', 'n8', 'n9', 'n10', 'n100', 'n1000'] as const;
  const seen = new Set<string>();
  for (const n of nums) {
    const v = (pack.text?.[n] ?? '').trim();
    if (seen.has(v) && v) at(`${n} repeats another number ("${v}")`);
    seen.add(v);
  }
  for (const id of ALL_PHRASES) {
    const v = pack.text?.[id] ?? '';
    if (/\b(TODO|FIXME|\?\?\?)\b/.test(v)) at(`${id} has a placeholder`);
    if (WORDS(v) > 14) at(`${id} is unusually long`);
  }
  // Native text must not be copied English in a non-Latin language (a typical failure of a rushed pack).
  if (nonLatin && ALL_PHRASES.filter((id) => !NON_LATIN_SCRIPT.test(pack.text?.[id] ?? '') && LATIN.test(pack.text?.[id] ?? '')).length > 3) at('several native phrases are in Latin letters');
}

const index = `/** Generated by scripts/check-phrases.mts — one lazy loader per language pack. */
import type { PhrasePack } from './types';

export const phraseLoaders: Record<string, () => Promise<{ default: PhrasePack }>> = {
${langs.map((l) => `  ${l}: () => import('./${l}'),`).join('\n')}
};

export const phraseLanguages = ${JSON.stringify(langs)} as const;
`;
writeFileSync(join(dir, 'index.ts'), index);
console.log(problems.length ? problems.join('\n') + `\n${problems.length} problem(s) in ${langs.length} pack(s)` : `${langs.length} phrasebook pack(s) valid`);
process.exit(problems.length ? 1 : 0);
