{
  "name": "@mascot/web",
  "version": "0.1.0",
  "private": true,
  "description": "Mascot AI — Telegram Mini App",
  "scripts": {
    "dev": "node scripts/build-worker.mjs && next dev --port 3000",
    "build": "node scripts/build-worker.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
