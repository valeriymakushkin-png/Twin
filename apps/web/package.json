    "i18n:check": "node --experimental-strip-types --no-warnings scripts/check-i18n.mts"
  },
  "dependencies": {
    "@mascot/mascot-3d": "workspace:*",
    "@mascot/shared": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "geist": "^1.5.1",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3"
  }
