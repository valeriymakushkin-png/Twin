# ─────────────────────────────────────────────────────────────────────────────
# Mascot AI — environment reference (API + workers). Copy to apps/api/.env for local dev.
# Every variable is validated at boot (apps/api/src/config/env.ts); production refuses
# unsafe defaults (dev JWT secret, dev auth, local storage...).
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
CORS_ORIGINS=
TRUST_PROXY_HOPS=1

# Data
DATABASE_URL=postgresql://mascot:mascot@localhost:5432/mascot?schema=public
DIRECT_DATABASE_URL=postgresql://mascot:mascot@localhost:5432/mascot?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=local-dev-secret-change-me-1234567890
JWT_TTL_SECONDS=86400
ADMIN_JWT_TTL_SECONDS=43200
DEV_AUTH_ENABLED=true
METRICS_TOKEN=

# Telegram (create the bot + Mini App in @BotFather — see docs/08-telegram.md)
TELEGRAM_BOT_TOKEN=000000:dev-token
TELEGRAM_BOT_USERNAME=MascotAIBot
TELEGRAM_MINI_APP_SHORT_NAME=app
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TEST_ENV=false
TELEGRAM_ADMIN_IDS=
TELEGRAM_SUPPORT_USERNAME=MascotAISupport
TELEGRAM_NOTIFICATIONS_ENABLED=true

# Storage — local disk for dev, Cloudflare R2 in production
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=mascot-private
S3_PUBLIC_BUCKET=mascot-public
S3_FORCE_PATH_STYLE=false
PUBLIC_CDN_URL=https://cdn.mascot.ai
SIGNED_URL_TTL_SECONDS=900

# AI providers — "mock" runs the whole product locally with zero AI spend
AI_IMAGE_PROVIDER=mock          # openai | flux | mock
AI_VIDEO_PROVIDER=mock          # kling | runway | veo | mock
FACE_ANALYSIS_PROVIDER=mock     # service | mock
VISION_PROVIDER=mock            # openai | mock
TTS_PROVIDER=mock               # openai | mock
MODERATION_PROVIDER=none        # openai | none
BACKGROUND_REMOVAL=none         # face-service | none
AVATAR_CANDIDATES=2

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_INPUT_FIDELITY=high
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_MODERATION_MODEL=omni-moderation-latest
BFL_API_KEY=
FLUX_MODEL=flux-kontext-pro
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_MODEL=kling-v2-1
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo
GEMINI_API_KEY=
VEO_MODEL=veo-3.0-fast-generate-001

FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_TOKEN=dev-face-token

# Policies & throughput
PHOTO_RETENTION_DAYS=30
AUTO_BAN_RISK_SCORE=100
IMAGE_PROVIDER_RPM=120
VIDEO_PROVIDER_RPM=20
WORKER_CONCURRENCY_AVATAR=4
WORKER_CONCURRENCY_STICKER=4
WORKER_CONCURRENCY_MEME=8
WORKER_CONCURRENCY_PFP=8
WORKER_CONCURRENCY_VIDEO=10
WORKER_CONCURRENCY_TELEGRAM=4
# WORKER_QUEUES=all            # or a subset, e.g. "video" for a dedicated pool
